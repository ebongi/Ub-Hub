# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini and Fapshi credentials are NOT set here — they live in the
# gemini-proxy/fapshi-proxy Supabase Edge Function secrets instead
# (`supabase secrets set ...`), never in the app bundle. See
# supabase/functions/gemini-proxy and supabase/functions/fapshi-proxy.

# Firebase
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
